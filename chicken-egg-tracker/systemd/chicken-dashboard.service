[Unit]
Description=Coop Tracker — web dashboard
After=network-online.target

[Service]
Type=simple
# Adjust User and paths to match your Pi.
User=pi
WorkingDirectory=/home/pi/chicken-egg-tracker
ExecStart=/usr/bin/python3 dashboard.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
